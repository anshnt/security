  {
    "id": "AEG-RANSOM-GENERIC",
    "name": "Ransomware behaviour strings",
    "severity": "critical",
    "category": "ransomware",
    "description": "Combination of shadow-copy deletion, recovery disabling and ransom note text typical of ransomware binaries.",
    "mitre": ["T1486", "T1490"],
    "file_types": ["pe", "script", "text"],
    "strings": {
      "a": {"regex": "(?i)vssadmin(\\.exe)?\\s+delete\\s+shadows", "wide": false},
      "a2": {"text": "delete shadows /all /quiet", "nocase": true, "wide": true},
      "b": {"regex": "(?i)bcdedit(\\.exe)?\\s+/set\\s+\\{?default\\}?\\s+(recoveryenabled\\s+no|bootstatuspolicy\\s+ignoreallfailures)"},
      "c": {"regex": "(?i)wbadmin(\\.exe)?\\s+delete\\s+catalog"},
      "d": {"regex": "(?i)(your (important )?files (have been|are) encrypted|all of your files|decrypt(ion)? (tool|key|software)|to recover your (files|data))", "wide": false},
      "d2": {"text": "your files are encrypted", "nocase": true, "wide": true},
      "e": {"regex": "(?i)[a-z2-7]{56}\\.onion"},
      "f": {"regex": "(?i)(bitcoin|monero|btc wallet)"}
    },
    "condition": "((a or a2) and (b or c)) or ((a or a2 or b or c) and (d or d2) and (e or f)) or ((d or d2) and e and f)"
  },
